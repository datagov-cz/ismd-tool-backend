    "název" : {
      "cs" : "student je v rodinném stavu"
    },
    "popis" : {
      "cs" : "Uvádí se číselný kód na základě sdělení studenta (povinnost sdělit tento údaj vyplývá z par. 88 odst. 2 zákona) podle číselníku Rodinný stav."
    },
    "definiční-obor" : "https://slovník.gov.cz/slovník-a3791-vysoké-školy---studium-a-student/pojem/student",
