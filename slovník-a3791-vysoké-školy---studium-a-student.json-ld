    "název" : {
      "cs" : "Aprobace"
    },
    "popis" : {
      "cs" : "Uvádí se číselný kód podle číselníku Aprobace, přičemž nezáleží na pořadí aprobací (1-3) (neexistuje-li tato informace, položka se ponechá nevyplněna)."
    },
