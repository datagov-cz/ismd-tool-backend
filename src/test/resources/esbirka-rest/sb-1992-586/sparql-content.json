  "parent": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/cast_1/par_2a/odst_8",
  "citace": "§ 2a odst. 8 písm. c)",
  "order": "6B5F4DE0",
  "obsah": "<var>c)</var> kalendářního měsíce, ve kterém přestane být"
 },
 {
  "iri": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/cast_1/par_2a/odst_8/pism_c/bod_1",
  "parent": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/cast_1/par_2a/odst_8/pism_c",
  "citace": "§ 2a odst. 8 písm. c) bod 1",
  "order": "6B5F4DEB",
  "obsah": "<var>1.</var> osobou samostatně výdělečně činnou podle zákona upravujícího důchodové pojištění, na kterou se vztahují právní předpisy upravující důchodové pojištění, nebo"
 },
 {
  "iri": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/cast_1/par_2a/odst_8/pism_c/bod_2",
  "parent": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/cast_1/par_2a/odst_8/pism_c",
  "citace": "§ 2a odst. 8 písm. c) bod 2",
  "order": "6B5F4DED",
  "obsah": "<var>2.</var> osobou samostatně výdělečně činnou podle zákona upravujícího veřejné <a data-odkaz-id=\"26009725\" href=\"#\" class=\"ext_odkaz\">zdravotní pojištění</a>, na kterou se vztahují právní předpisy upravující veřejné zdravotní pojištění,"
 },
 {
  "iri": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/cast_1/par_2a/odst_8/pism_d",
  "parent": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/cast_1/par_2a/odst_8",
  "citace": "§ 2a odst. 8 písm. d)",
  "order": "6B5F4E10",
  "obsah": "<var>d)</var> kalendářního měsíce bezprostředně předcházejícího kalendářnímu měsíci, od kterého poplatník není povinen platit pojistné na veřejné <a data-odkaz-id=\"26009751\" href=\"#\" class=\"ext_odkaz\">zdravotní pojištění</a> z důvodu dlouhodobého pobytu v cizině, nebo"
 },
 {
  "iri": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/cast_1/par_2a/odst_8/pism_e",
  "parent": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/cast_1/par_2a/odst_8",
  "citace": "§ 2a odst. 8 písm. e)",
  "order": "6B5F4E30",
  "obsah": "<var>e)</var> kalendářního měsíce, ve kterém se poplatník stane daňovým nerezidentem a přestane na území České republiky vykonávat činnost, ze které plynou příjmy ze samostatné činnosti."
 },
 {
  "iri": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/cast_1/par_3",
  "parent": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/cast_1",
