  "citace": null,
  "order": "6AD6",
  "obsah": "Tento zákon zapracovává příslušné předpisy Evropské unie<a data-odkaz-id=\"25470643\" href=\"#\" class=\"int_odkaz\"><sup>137</sup>)</a> a upravuje"
 },
 {
  "iri": "https://opendata.eselpoint.gov.cz/esel-esb/eli/cz/sb/1992/586/2026-08-01/dokument/norma/par_1/pism_a",
