    "typ" : [ "Pojem", "Koncept", "Třída" ],
    "název" : {
      "cs" : "Stavební objekt bez čísla domovního"
    },
    "definice" : {
      "cs" : "Stavebním objektem se rozumí dokončená budova zapisovaná do katastru nemovitostí, která je samostatnou věcí, nebo budova, která je součástí pozemku nebo součástí práva stavby a údaje o ní se do katastru nemovitostí zapisují k pozemku nebo k právu stavby, nebo jiná dokončená stavba, která se do katastru nemovitostí nezapisuje, ale bylo jí přiděleno číslo popisné nebo evidenční"
    },
    "nadřazená-třída" : [ "https://atom.cuzk.cz/a103-základní-registr---registr-územní-identifikace--adres-a-nemovitostí/pojem/stavební-objekt---budova" ],
